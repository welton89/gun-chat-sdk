{
  "name": "@gun-chat/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for decentralized chat using Gun.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:ui": "vite",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "gun",
    "gundb",
    "chat",
    "decentralized",
    "p2p",
    "typescript",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "gun": "^0.2020.1241",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/gun": "^0.9.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^7.2.6"
  }
}